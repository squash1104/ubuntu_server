from .models import Convidado # Importa o modelo Convidado
from .forms import ConvidadoForm
from colaboradores.models import Colaborador

def lista_convidados(request):
    convidados = Convidado.objects.all() # Busca todos os convidados no banco de dados
    return render(request, 'convidados/lista_convidados.html', {'convidados': convidados})

def colaborador_convidados(request, colaborador_id):
    colaborador = get_object_or_404(Colaborador, pk=colaborador_id)
    convidados_do_colaborador = Convidado.objects.filter(colaborador=colaborador).order_by('nome')
    return render(request, 'convidados/colaborador_convidados.html', {
	'colaborador': colaborador,
	'convidados': convidados_do_colaborador
})
