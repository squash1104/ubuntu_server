{
    "pythonVersion": "3.12",
    "venvPath": ".",
    "venv": ".venv",
    "include": [
        "."
    ],
    "exclude": [
        "**/node_modules",
        "**/__pycache__",
        ".venv",
        "venv",
        "migrations",
        "static",
        "media"
    ],
    "reportMissingImports": "warning",
    "reportMissingTypeStubs": false,
    "pythonPlatform": "Linux",
    "executionEnvironments": [
        {
            "root": ".",
            "pythonVersion": "3.12",
            "pythonPlatform": "Linux",
            "extraPaths": [
                "./.venv/lib/python3.12/site-packages"
            ]
        }
    ]
}